# Enforce Linux line endings for all text files
* text=auto eol=lf

# Keep Windows line endings only for Windows-specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary, declared rather than detected. `text=auto` guesses from content, and a tool that rewrites
# one of these as text silently strips every CR -- which truncates a PNG at its own signature.
*.png binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
