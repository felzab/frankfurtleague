# LF in every text file, committed and checked out: a CR fails a shell script on the Linux server.
* text=auto eol=lf

# Binary, declared rather than detected. `text=auto` guesses from content, and a tool that rewrites
# one of these as text silently strips every CR -- which truncates a PNG at its own signature.
*.png binary
*.ico binary

# Written by `pnpm patch-commit`, never by hand. A unified diff spells an empty context line as one
# space, which is the format's own content and no whitespace error.
fl_frontend/patches/*.patch -whitespace

# Written by `pnpm run contract` in fl_frontend, never by hand, so GitHub collapses each in a diff
# and leaves it out of the language statistics.
fl_backend/openapi.json linguist-generated=true
fl_frontend/src/core/generated/** linguist-generated=true
