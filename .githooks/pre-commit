#!/usr/bin/env bash
#
# GITHOOKS · refuse a commit on main, and format and re-stage the staged files of any other.
#
# Formatting happens at commit time and the gate only checks.
#
# What reaches the index is formatted from the index, never read back off disk, so an editor
# autosave or a second agent writing while prettier runs cannot put unstaged content in the commit.
# The working copy of a file staged in part is never written.
#
# Convenience, never the enforcement, exactly as `commit-msg` is: a clone that has not run
# `git config core.hooksPath .githooks` has no hook, and one that has not installed the frontend has
# no prettier, so `./scripts/gate/verify.sh --frontend` and CI's format job are what bind
# (`docs/_git/spec.md :: 1.5 The verification gate`).

set -euo pipefail

# Prettier's parser set, from `--support-info`, minus the editor and interchange aliases. Missing
# one costs a later gate failure, never a wrong commit, so where it is unsure the list stays small.
# The bare names are the two this stack could grow.
formattable() {
  case "${1,,}" in
    *.ts | *.tsx | *.cts | *.mts | *.js | *.jsx | *.cjs | *.mjs) return 0 ;;
    *.json | *.jsonc | *.json5 | *.webmanifest) return 0 ;;
    *.css | *.scss | *.less) return 0 ;;
    *.md | *.markdown | *.mdx) return 0 ;;
    *.yml | *.yaml) return 0 ;;
    *.html | *.htm | *.vue) return 0 ;;
    *.graphql | *.gql | *.hbs | *.handlebars) return 0 ;;
    .prettierrc | */.prettierrc | .babelrc | */.babelrc) return 0 ;;
  esac
  return 1
}

# Ten names and a count, so a bulk commit's report stays readable.
name_files() {
  printf '      %s\n' "${@:1:10}"
  if [ $# -gt 10 ]; then echo "      ... and $(($# - 10)) more"; fi
}

# Native programs cannot open an MSYS path: `git hash-object` reads mktemp's /tmp alias from a
# worktree unconverted, and node the hook's own path — the resolution
# `scripts/gate/selfcheck.sh :: mount_source` also applies.
windows_path() {
  cygpath -w "$1" 2>/dev/null || printf '%s' "$1"
}

# Beside this hook rather than in the committing tree: `core.hooksPath` can name another checkout,
# whose helper is this hook's own version and the committing tree's may be any other, or none.
if ! helper="$(windows_path "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/format-staged.mjs")"; then
  echo "  pre-commit hook: could not find the directory it runs from — the commit is refused." >&2
  exit 1
fi

if ! repo_root="$(git rev-parse --show-toplevel)"; then
  echo "  pre-commit hook: could not find the repository root — the commit is refused." >&2
  exit 1
fi
cd "$repo_root"

# `main` takes changes only through a pull request: the ruleset refuses the push, and this refuses
# the commit that would otherwise have to be moved off `main` afterwards.
if [ "$(git branch --show-current 2>/dev/null)" = "main" ]; then
  echo "  pre-commit hook: HEAD is main, which takes changes only through a pull request — the commit is refused." >&2
  echo "  Branch first, and the uncommitted work comes with you:  git checkout -b <short-kebab-name>" >&2
  exit 1
fi

# Ahead of the first query, because every one of them is read from a file in here.
if ! work="$(mktemp -d)"; then
  echo "  pre-commit hook: could not make a scratch directory — the commit is refused." >&2
  exit 1
fi
work="$(windows_path "$work")"
trap 'rm -rf "$work"' EXIT

# `diff.relative` would relativise these to the invoking directory; every line below joins them onto
# the root. `--no-renames` reports a rename as the add `A` names, `T` a symlink turned file; a staged
# deletion `D` has nothing to format.
if ! git --literal-pathspecs -c diff.relative=false diff --cached --raw --no-abbrev -z --no-renames \
     --diff-filter=ACMT > "$work/staged"; then
  # Through a file, never a process substitution: nothing observes one's status, `set -e` does not
  # fire on it, and a query that failed there reads as an empty stage — an unformatted commit with
  # nothing printed.
  echo "  pre-commit hook: could not read the staged files — the commit is refused." >&2
  exit 1
fi

staged=()
declare -A index_mode index_oid
while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
  # `:<old mode> <new mode> <old oid> <new oid> <status>`, the new side being the index's.
  meta="${meta#* }"
  mode="${meta%% *}"
  meta="${meta#* * }"
  oid="${meta%% *}"
  # A symlink's blob is its target's name, which prettier has no business rewriting.
  case "$mode" in 100644 | 100755) ;; *) continue ;; esac
  if formattable "$path"; then
    staged+=("$path")
    index_mode["$path"]="$mode"
    index_oid["$path"]="$oid"
  fi
done < "$work/staged"

# Nothing prettier reads, so a backend or shell commit pays no node startup.
if [ ${#staged[@]} -eq 0 ]; then
  exit 0
fi

if ! git --literal-pathspecs -c diff.relative=false diff --name-only -z > "$work/dirty"; then
  echo "  pre-commit hook: could not read the worktree state — refusing rather than guessing." >&2
  exit 1
fi

declare -A partial
while IFS= read -r -d '' path; do
  if [ -n "${index_oid["$path"]:-}" ]; then partial["$path"]=1; fi
done < "$work/dirty"

# Absent means an install nobody has run, which is a reason to let the commit through rather than
# block work the gate judges regardless.
if ! command -v node >/dev/null 2>&1 || [ ! -f fl_frontend/node_modules/prettier/package.json ]; then
  echo "  pre-commit hook: no prettier found — skipping." >&2
  echo "  ./scripts/gate/verify.sh --frontend and CI still check this." >&2
  exit 0
fi

: > "$work/manifest"
: > "$work/oids"
for path in "${staged[@]}"; do
  if [ -n "${partial["$path"]:-}" ]; then flag=P; else flag=W; fi
  printf '%s\0%s\0' "$flag" "$path" >> "$work/manifest"
  printf '%s\n' "${index_oid["$path"]}" >> "$work/oids"
done

# The index copies, never the working copies: whatever the worktree holds by now cannot reach the
# commit.
if ! git cat-file --batch < "$work/oids" > "$work/blobs"; then
  echo "  pre-commit hook: could not read the staged copies — the commit is refused." >&2
  exit 1
fi

# One node for the whole stage: a process per file pays prettier's and both plugins' load each time.
status=0
( cd fl_frontend && node "$helper" format "$work" ) || status=$?
if [ "$status" -ne 0 ]; then
  echo "  pre-commit hook: formatting exited $status, so the commit is refused and nothing was staged —" >&2
  echo "  its reason is above." >&2
  exit "$status"
fi

restaged=()
in_part=()
: > "$work/stage"
while IFS= read -r -d '' index; do
  path="${staged[$index]}"
  # `--path` applies the real path's `.gitattributes`, as `git add` would; the temporary file's own
  # name would not.
  if ! oid="$(git hash-object -w --path="$path" -- "$work/formatted/$index")"; then
    echo "  pre-commit hook: could not store the formatted $path — the commit is refused." >&2
    exit 1
  fi
  printf '%s %s\t%s\0' "${index_mode["$path"]}" "$oid" "$path" >> "$work/stage"
  restaged+=("$path")
  if [ -n "${partial["$path"]:-}" ]; then in_part+=("$path"); fi
done < "$work/restage"

raced=()
while IFS= read -r -d '' index; do raced+=("${staged[$index]}"); done < "$work/raced"

# Git refuses an empty commit only before this hook runs, so formatting that turns every staged
# change back into HEAD's would commit nothing. A merge's tree may equal HEAD's by design.
if [ ${#restaged[@]} -gt 0 ] && head_tree="$(git rev-parse -q --verify 'HEAD^{tree}')" \
   && ! git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  # A copy, so the refusal leaves the real index as it was.
  if ! index_file="${GIT_INDEX_FILE:-$(git rev-parse --path-format=absolute --git-path index)}" \
     || ! cp "$index_file" "$work/probe-index" \
     || ! GIT_INDEX_FILE="$work/probe-index" git update-index -z --index-info < "$work/stage" \
     || ! probe_tree="$(GIT_INDEX_FILE="$work/probe-index" git write-tree)"; then
    echo "  pre-commit hook: could not tell whether formatting left anything to commit — the commit is refused." >&2
    exit 1
  fi
  # The hook cannot see `--amend`, so an amend staging formatting alone is refused too; `--no-verify`
  # makes that one.
  if [ "$probe_tree" = "$head_tree" ]; then
    {
      echo "  pre-commit hook: formatted, every staged change is what HEAD already holds, so the commit would"
      echo "  be empty — it is refused, and nothing was staged or written. To amend only the message, pass"
      echo "  --no-verify:"
      name_files "${restaged[@]}"
    } >&2
    exit 1
  fi
fi

if [ ${#restaged[@]} -gt 0 ]; then
  if ! git update-index -z --index-info < "$work/stage"; then
    echo "  pre-commit hook: could not write the index — the commit is refused." >&2
    exit 1
  fi

  # `git commit -- <path>` commits a temporary index and has already written the real one, at its
  # lock, from the unformatted worktree copy; staged in the temporary one alone, the file reads as
  # staged in part at the next commit.
  index_name="${GIT_INDEX_FILE:-}"
  index_name="${index_name##*/}"
  # The temporary index's name is git's internals, no documented interface: `prepare_index` in
  # https://github.com/git/git/blob/9a2fb147f2c61d0cab52c883e7e26f5b7948e3ed/builtin/commit.c
  # (v2.52.0) names it `next-index-<pid>.lock` in the git directory, beside the real index's lock.
  if [[ "$index_name" == next-index-*.lock ]] \
     && git_dir="$(git rev-parse --absolute-git-dir)" \
     && [ "$GIT_INDEX_FILE" -ef "$git_dir/$index_name" ] \
     && default_lock="$(git rev-parse --path-format=absolute --git-path index.lock)" \
     && [ -f "$default_lock" ] \
     && ! GIT_INDEX_FILE="$default_lock" git update-index -z --index-info < "$work/stage"; then
    echo "  pre-commit hook: could not write the real index beside the commit's — the commit is refused." >&2
    exit 1
  fi

  {
    echo "  pre-commit hook: staged ${#restaged[@]} file(s) formatted from the index:"
    name_files "${restaged[@]}"
  } >&2
fi

# Last, once the index holds what the commit will: every refusal above leaves the working copies as
# they were.
unwritten=()
if [ -s "$work/rewrite" ]; then
  if ! ( cd fl_frontend && node "$helper" write "$work" ); then
    echo "  pre-commit hook: could not finish writing the formatted working copies. The commit holds them" >&2
    echo "  formatted, and \`git status\` names any copy left as it was." >&2
  fi
  if [ -f "$work/raced-late" ]; then
    while IFS= read -r -d '' index; do raced+=("${staged[$index]}"); done < "$work/raced-late"
  fi
  if [ -f "$work/unwritten" ]; then
    while IFS= read -r -d '' index; do unwritten+=("${staged[$index]}"); done < "$work/unwritten"
  fi
fi

if [ ${#in_part[@]} -gt 0 ]; then
  {
    echo "  pre-commit hook: ${#in_part[@]} of them are staged in part. The commit holds the staged half"
    echo "  formatted, and the working copy is left as it is, since writing it would rewrite work nobody"
    echo "  has staged. So \`git status\` shows each as changed, and \`git diff\` shows the formatting"
    echo "  reversed beside the unstaged edits, until the file is formatted and staged:"
    name_files "${in_part[@]}"
  } >&2
fi

if [ ${#raced[@]} -gt 0 ]; then
  {
    echo "  pre-commit hook: ${#raced[@]} file(s) were written or removed while the hook ran. The commit"
    echo "  holds the staged content formatted; the working copy is left exactly as that writer left it:"
    name_files "${raced[@]}"
  } >&2
fi

if [ ${#unwritten[@]} -gt 0 ]; then
  {
    echo "  pre-commit hook: ${#unwritten[@]} working cop(ies) could not be written. The commit holds them"
    echo "  formatted; \`git status\` shows what each holds now:"
    name_files "${unwritten[@]}"
  } >&2
fi
