#!/usr/bin/env bash
#
# GITHOOKS · refuse a commit on main, and format and re-stage the staged files of any other.
#
# Formatting happens at commit time and the gate only checks.
#
# What reaches the index is formatted from the index, never read back off disk, so an editor
# autosave or a second agent writing while prettier runs cannot put unstaged content in the commit.
# The working copy of a file staged in part is never written.
#
# Convenience, never the enforcement, exactly as `commit-msg` is: a clone that has not run
# `git config core.hooksPath .githooks` has no hook, and one that has not installed the frontend has
# no prettier, so `./scripts/gate/verify.sh --frontend` and CI's format job are what bind
# (`docs/_git/spec.md :: 1.5 The verification gate`).

set -euo pipefail

# Windows refuses a command line past 32,767 bytes, and the formattable tree already costs more
# than that in the `../` spelling below. A batch flushes before crossing this budget; Linux has
# no practical limit here.
ARGV_BUDGET=24000

# Prettier's parser set, from `--support-info`, minus the editor and interchange aliases. Missing
# one costs a later gate failure, never a wrong commit, so where it is unsure the list stays small.
# The bare names are the two this stack could grow.
formattable() {
  case "${1,,}" in
    *.ts | *.tsx | *.cts | *.mts | *.js | *.jsx | *.cjs | *.mjs) return 0 ;;
    *.json | *.jsonc | *.json5 | *.webmanifest) return 0 ;;
    *.css | *.scss | *.less) return 0 ;;
    *.md | *.markdown | *.mdx) return 0 ;;
    *.yml | *.yaml) return 0 ;;
    *.html | *.htm | *.vue) return 0 ;;
    *.graphql | *.gql | *.hbs | *.handlebars) return 0 ;;
    .prettierrc | */.prettierrc | .babelrc | */.babelrc) return 0 ;;
  esac
  return 1
}

# Ten names and a count, so a bulk commit's report stays readable.
name_files() {
  printf '      %s\n' "${@:1:10}"
  if [ $# -gt 10 ]; then echo "      ... and $(($# - 10)) more"; fi
}

if ! repo_root="$(git rev-parse --show-toplevel)"; then
  echo "  pre-commit hook: could not find the repository root — the commit is refused." >&2
  exit 1
fi
cd "$repo_root"

# `main` takes changes only through a pull request: the ruleset refuses the push, and this refuses
# the commit that would otherwise have to be moved off `main` afterwards.
if [ "$(git branch --show-current 2>/dev/null)" = "main" ]; then
  echo "  pre-commit hook: HEAD is main, which takes changes only through a pull request — the commit is refused." >&2
  echo "  Branch first, and the uncommitted work comes with you:  git checkout -b <short-kebab-name>" >&2
  exit 1
fi

# Ahead of the first query, because every one of them is read from a file in here.
if ! work="$(mktemp -d)"; then
  echo "  pre-commit hook: could not make a scratch directory — the commit is refused." >&2
  exit 1
fi
# `git hash-object` cannot open mktemp's MSYS alias (/tmp/…) from a worktree, where no conversion
# layer rewrites the argument — the resolution `scripts/gate/selfcheck.sh :: mount_source` also applies.
work="$(cygpath -w "$work" 2>/dev/null || printf '%s' "$work")"
trap 'rm -rf "$work"' EXIT

# `diff.relative` would relativise these to the invoking directory; every line below joins them onto
# the repository root. `--no-renames` turns a rename into the add `A` names, and `D` is left out
# because a staged deletion has no file to format.
if ! git --literal-pathspecs -c diff.relative=false diff --cached --name-only -z --no-renames \
     --diff-filter=ACM > "$work/staged"; then
  # Through a file, never a process substitution: nothing observes one's status, `set -e` does not
  # fire on it, and a query that failed there reads as an empty stage — an unformatted commit with
  # nothing printed.
  echo "  pre-commit hook: could not read the staged files — the commit is refused." >&2
  exit 1
fi

staged=()
while IFS= read -r -d '' path; do
  if formattable "$path"; then staged+=("$path"); fi
done < "$work/staged"

# Nothing prettier reads, so a backend or shell commit pays no node startup.
if [ ${#staged[@]} -eq 0 ]; then
  exit 0
fi

declare -A candidate
for path in "${staged[@]}"; do candidate["$path"]=1; done

# A file staged in part never reaches the write pass below, which would format its unstaged half on
# disk too; its commit copy is formatted from the index like every other file's.
if ! git --literal-pathspecs -c diff.relative=false diff --name-only -z > "$work/dirty"; then
  echo "  pre-commit hook: could not read the worktree state — refusing rather than guessing." >&2
  exit 1
fi

declare -A partial
while IFS= read -r -d '' path; do
  if [ -n "${candidate["$path"]:-}" ]; then partial["$path"]=1; fi
done < "$work/dirty"

# By path rather than through `node_modules/.bin`, whose shim differs per platform and needs node on
# PATH anyway. Absent means an install nobody has run, which is a reason to let the commit through
# rather than block work the gate judges regardless.
prettier_entry="node_modules/prettier/bin/prettier.cjs"
if ! command -v node >/dev/null 2>&1 || [ ! -f "fl_frontend/$prettier_entry" ]; then
  echo "  pre-commit hook: no prettier found — skipping." >&2
  echo "  ./scripts/gate/verify.sh --frontend and CI still check this." >&2
  exit 0
fi

# Invoked exactly as `pnpm format` invokes it, same directory and same ignore file, so the hook
# cannot reach a file the gate's own run leaves alone. The `../` prefix stops a file named like an
# option from being read as one.
prettier_write() {
  ( cd fl_frontend && node "$prettier_entry" --write --log-level warn --ignore-unknown \
      --ignore-path ../.prettierignore "$@" )
}

# Never called with an empty batch: prettier with no file argument reads stdin, and a hook that
# waits on stdin hangs the commit. Each batch's status is kept, so an early failure is not lost
# behind a later success.
run_batched() {
  local -a batch=()
  local bytes=0 rc=0 one arg
  for arg in "$@"; do
    if [ ${#batch[@]} -gt 0 ] && [ $((bytes + ${#arg} + 1)) -gt "$ARGV_BUDGET" ]; then
      one=0
      prettier_write "${batch[@]}" || one=$?
      if [ "$one" -gt "$rc" ]; then rc="$one"; fi
      batch=()
      bytes=0
    fi
    batch+=("$arg")
    bytes=$((bytes + ${#arg} + 1))
  done
  if [ ${#batch[@]} -gt 0 ]; then
    one=0
    prettier_write "${batch[@]}" || one=$?
    if [ "$one" -gt "$rc" ]; then rc="$one"; fi
  fi
  return "$rc"
}

args=()
for path in "${staged[@]}"; do
  if [ -z "${partial["$path"]:-}" ]; then args+=("../$path"); fi
done
status=0
run_batched "${args[@]}" || status=$?

# Filtered against the candidate set rather than passed as a pathspec: a pathspec naming the whole
# formattable tree is itself over the argv ceiling.
if ! git --literal-pathspecs -c diff.relative=false diff --name-only -z > "$work/after"; then
  echo "  pre-commit hook: could not read the worktree after formatting — the commit is refused." >&2
  exit 1
fi

changed=()
while IFS= read -r -d '' path; do
  if [ -n "${candidate["$path"]:-}" ]; then changed+=("$path"); fi
done < "$work/after"

raced=()
restaged=()
in_part=()
restage_failed=0

if [ ${#changed[@]} -gt 0 ]; then
  if ! git ls-files -s -z > "$work/index"; then
    echo "  pre-commit hook: could not read the index — the commit is refused." >&2
    exit 1
  fi

  declare -A index_mode index_oid
  while IFS= read -r -d '' entry; do
    meta="${entry%%$'\t'*}"
    path="${entry#*$'\t'}"
    if [ -n "${candidate["$path"]:-}" ]; then
      index_mode["$path"]="${meta%% *}"
      meta="${meta#* }"
      index_oid["$path"]="${meta%% *}"
    fi
  done < "$work/index"

  # The staged bytes are prettier's output for the INDEX copy, so whatever the worktree holds by now
  # cannot reach the commit. `--stdin-filepath` keeps it exact: config and ignore rules resolve from
  # the real path, which no temporary tree reproduces.
  : > "$work/stage"
  for path in "${changed[@]}"; do
    if ! git cat-file blob "${index_oid["$path"]}" > "$work/blob"; then
      echo "  pre-commit hook: could not read the staged copy of $path — the commit is refused." >&2
      exit 1
    fi
    if ! ( cd fl_frontend && node "$prettier_entry" --stdin-filepath "../$path" --log-level warn \
             --ignore-unknown --ignore-path ../.prettierignore \
             < "$work/blob" > "$work/formatted" ); then
      restage_failed=$((restage_failed + 1))
      continue
    fi
    # Ahead of the restage below, which a staged copy already formatted skips: a writer on a fully
    # staged file is reported either way.
    if [ -z "${partial["$path"]:-}" ] && ! cmp -s -- "$work/formatted" "$path"; then raced+=("$path"); fi
    if cmp -s -- "$work/blob" "$work/formatted"; then continue; fi
    if ! oid="$(git hash-object -w --path="$path" -- "$work/formatted")"; then
      echo "  pre-commit hook: could not store the formatted $path — the commit is refused." >&2
      exit 1
    fi
    printf '%s %s\t%s\0' "${index_mode["$path"]}" "$oid" "$path" >> "$work/stage"
    restaged+=("$path")
    if [ -n "${partial["$path"]:-}" ]; then in_part+=("$path"); fi
  done
fi

if [ "$restage_failed" -gt 0 ]; then
  echo "  pre-commit hook: could not format $restage_failed staged file(s) from the index." >&2
  if [ "$status" -eq 0 ]; then status=1; fi
fi

# Prettier answers 2 for a file that will not parse and 1 for a config naming a plugin nobody
# installed. Both refuse: the first is a verdict on the commit, the second a tree nothing can
# format. Absent, handled above, is the only case that stands aside.
if [ "$status" -ne 0 ]; then
  echo "  pre-commit hook: prettier exited $status, so the commit is refused and nothing was staged —" >&2
  echo "  its reason is above." >&2
  exit "$status"
fi

if [ ${#restaged[@]} -gt 0 ]; then
  if ! git update-index -z --index-info < "$work/stage"; then
    echo "  pre-commit hook: could not write the index — the commit is refused." >&2
    exit 1
  fi

  # `git commit -- <path>` commits a temporary index and has already written the real one, at its
  # lock, from the unformatted worktree copy; staged in the temporary one alone, the file reads as
  # staged in part at the next commit.
  index_name="${GIT_INDEX_FILE:-}"
  index_name="${index_name##*/}"
  # The temporary index's name is git's internals, no documented interface: `prepare_index` in
  # https://github.com/git/git/blob/9a2fb147f2c61d0cab52c883e7e26f5b7948e3ed/builtin/commit.c
  # (v2.52.0) names it `next-index-<pid>.lock` in the git directory, beside the real index's lock.
  if [[ "$index_name" == next-index-*.lock ]] \
     && git_dir="$(git rev-parse --absolute-git-dir)" \
     && [ "$GIT_INDEX_FILE" -ef "$git_dir/$index_name" ] \
     && default_lock="$(git rev-parse --path-format=absolute --git-path index.lock)" \
     && [ -f "$default_lock" ] \
     && ! GIT_INDEX_FILE="$default_lock" git update-index -z --index-info < "$work/stage"; then
    echo "  pre-commit hook: could not write the real index beside the commit's — the commit is refused." >&2
    exit 1
  fi

  {
    echo "  pre-commit hook: staged ${#restaged[@]} file(s) formatted from the index:"
    name_files "${restaged[@]}"
  } >&2
fi

if [ ${#in_part[@]} -gt 0 ]; then
  {
    echo "  pre-commit hook: ${#in_part[@]} of them are staged in part. The commit holds the staged half"
    echo "  formatted, and the working copy is left as it is, since writing it would rewrite work nobody"
    echo "  has staged. So \`git status\` shows each as changed, and \`git diff\` shows the formatting"
    echo "  reversed beside the unstaged edits, until the file is formatted and staged:"
    name_files "${in_part[@]}"
  } >&2
fi

if [ ${#raced[@]} -gt 0 ]; then
  {
    echo "  pre-commit hook: ${#raced[@]} file(s) were written while prettier ran. The commit holds the"
    echo "  staged content formatted; the working copy is left exactly as that writer left it:"
    name_files "${raced[@]}"
  } >&2
fi
