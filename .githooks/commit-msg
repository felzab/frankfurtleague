#!/usr/bin/env bash
#
# GITHOOKS · refuse a commit message that breaks the convention, at the one moment fixing it is free.
#
# Convenience, never the enforcement. A clone that has not run `git config core.hooksPath .githooks`
# has no hook at all (`docs/_git/spec.md :: 1.3 Commits`), so `./scripts/verify.sh --docs` over
# the whole branch is what binds. Anything this catches, the gate catches too — later, and after a
# rebase costs something.
#
# It never blocks on a missing interpreter: a contributor without the backend venv gets the gate's
# verdict instead of a commit they cannot make.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

for candidate in "${repo_root}/fl_backend/.venv/Scripts/python.exe" \
                 "${repo_root}/fl_backend/.venv/bin/python" \
                 python3 python; do
  if command -v "$candidate" >/dev/null 2>&1; then
    exec "$candidate" "${repo_root}/scripts/check_commits.py" --message-file "$1"
  fi
done

echo "  commit-msg hook: no python found — skipping. ./scripts/verify.sh --docs still checks this." >&2
exit 0
