{
  "$schema": "https://raw.githubusercontent.com/felzab/orchestra/main/schema/orchestra.schema.json",
  "models": {
    "default": { "model": "opus", "effort": "high" },
    "judgement": { "model": "fable", "effort": "high" }
  },
  "preflight": [
    {
      "run": ["docker", "info"],
      "why": "the database tier starts its own MongoDB containers, and the gate runs it"
    }
  ],
  "land": {
    "steps": [
      {
        "kind": "install",
        "when": ["fl_frontend/package.json", "fl_frontend/pnpm-lock.yaml"],
        "cwd": "fl_frontend",
        "run": ["pnpm", "install", "--frozen-lockfile"]
      },
      {
        "kind": "install",
        "when": ["fl_backend/pyproject.toml", "fl_backend/uv.lock"],
        "run": ["uv", "sync", "--project", "fl_backend", "--dev", "--frozen"]
      },
      {
        "kind": "regenerate",
        "when": ["fl_backend/"],
        "cwd": "fl_frontend",
        "run": ["pnpm", "run", "contract"],
        "writes": ["fl_backend/openapi.json", "fl_frontend/src/core/generated/"]
      },
      {
        "kind": "check",
        "when": ["fl_frontend/"],
        "cwd": "fl_frontend",
        "run": ["pnpm", "run", "typecheck"]
      },
      {
        "kind": "check",
        "when": ["fl_backend/"],
        "cwd": "fl_backend",
        "run": ["uv", "run", "--frozen", "python", "-m", "pyright"]
      },
      {
        "kind": "check",
        "when": ["scripts/"],
        "cwd": "scripts",
        "run": ["uv", "run", "--project", "../fl_backend", "--frozen", "python", "-m", "pyright"]
      }
    ]
  },
  "lenses": {
    "triggers": [
      {
        "name": "data",
        "when": [
          "fl_backend/app",
          "fl_frontend/src/core/auth",
          "fl_frontend/src/core/db.ts",
          "fl_frontend/src/core/authIndexes.ts",
          "fl_frontend/src/core/action.ts",
          "fl_frontend/src/features/*/queries.ts",
          "fl_frontend/src/features/*/actions.ts",
          "fl_frontend/src/features/*/mutations.ts"
        ]
      },
      {
        "name": "cost",
        "when": [
          "fl_backend/app/core",
          "fl_backend/app/main.py",
          "fl_backend/app/asgi.py",
          "fl_frontend/src/proxy.ts",
          "fl_frontend/src/instrumentation.ts",
          "fl_frontend/src/instrumentationNode.ts",
          "fl_frontend/src/core/api.ts",
          "fl_frontend/src/scheduler.ts",
          "fl_frontend/src/core/logging.ts",
          "fl_frontend/src/core/auth/session.ts",
          "fl_frontend/src/app/layout.tsx",
          "fl_frontend/next.config.ts",
          "nginx"
        ]
      },
      {
        "name": "accessibility",
        "when": ["fl_frontend/src/app", "fl_frontend/src/kit", "fl_frontend/src/features/*/*.tsx"]
      },
      { "name": "disclosure", "when": ["**"] },
      {
        "name": "security",
        "when": [".claude/CLAUDE.md", ".claude/rules", ".claude/orchestra", "docs/decisions.md"]
      },
      {
        "name": "practice",
        "when": [
          "fl_backend",
          "fl_frontend",
          "scripts",
          "nginx",
          ".github",
          ".claude/hooks",
          "docker-bake.hcl",
          "docker-compose.yml",
          "docker-compose.local.yml",
          "docker-compose.e2e.yml"
        ]
      }
    ]
  },
  "ci": {
    "workflow": "verify",
    "verdict": "^\\s*✗\\s+(?P<text>.+?)(?:\\s+(?:\\d+m\\s*)?[\\d.]+m?s)?$",
    "relay": "^A scope job failed\\b",
    "findings": ["^\\s*(?P<text>\\S+\\(\\d+,\\d+\\): error TS\\d+: .+)$"],
    "cases": ["^\\s*FAIL\\s+(?:\\|[^|]+\\|\\s+|\\S+\\s{2,}(?=\\S))?(?P<name>\\S.*?)(?:\\s+\\[ [^\\]]+ \\])?\\s*$"]
  },
  "gate": { "run": ["bash", "./scripts/gate/verify.sh"] }
}
