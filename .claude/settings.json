{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": ["Edit(**/docs/_standard/**)"],
    "deny": [
      "Read(//**/.env*)",
      "Edit(//**/.env*)",
      "Read(//**/*.pem)",
      "Edit(//**/*.pem)",
      "Read(//**/*.key)",
      "Edit(//**/*.key)",
      "Read(//**/*.crt)",
      "Edit(//**/*.crt)",
      "Read(//**/*.cer)",
      "Edit(//**/*.cer)",
      "Read(//**/*.p12)",
      "Edit(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Edit(//**/*.pfx)",
      "Read(//**/*.p8)",
      "Edit(//**/*.p8)",
      "Read(//**/*.pk8)",
      "Edit(//**/*.pk8)",
      "Read(//**/*.asc)",
      "Edit(//**/*.asc)",
      "Read(//**/*.gpg)",
      "Edit(//**/*.gpg)",
      "Read(//**/*.ovpn)",
      "Edit(//**/*.ovpn)",
      "Read(//**/*.jks)",
      "Edit(//**/*.jks)",
      "Read(//**/*.keystore)",
      "Edit(//**/*.keystore)",
      "Read(//**/*.ppk)",
      "Edit(//**/*.ppk)",
      "Read(//**/*.kdbx)",
      "Edit(//**/*.kdbx)",
      "Read(//**/id_rsa*)",
      "Edit(//**/id_rsa*)",
      "Read(//**/id_dsa*)",
      "Edit(//**/id_dsa*)",
      "Read(//**/id_ecdsa*)",
      "Edit(//**/id_ecdsa*)",
      "Read(//**/id_ed25519*)",
      "Edit(//**/id_ed25519*)",
      "Read(//**/credentials.json)",
      "Edit(//**/credentials.json)",
      "Read(//**/*service-account*)",
      "Edit(//**/*service-account*)",
      "Read(//**/*service_account*)",
      "Edit(//**/*service_account*)",
      "Read(//**/kubeconfig)",
      "Edit(//**/kubeconfig)",
      "Read(//**/.npmrc)",
      "Edit(//**/.npmrc)",
      "Read(//**/.netrc)",
      "Edit(//**/.netrc)",
      "Read(//**/_netrc)",
      "Edit(//**/_netrc)",
      "Read(//**/.pgpass)",
      "Edit(//**/.pgpass)",
      "Read(//**/.htpasswd)",
      "Edit(//**/.htpasswd)",
      "Read(//**/.docker/config.json)",
      "Edit(//**/.docker/config.json)",
      "Read(//**/certs/**)",
      "Edit(//**/certs/**)",
      "Read(//**/secrets/**)",
      "Edit(//**/secrets/**)",
      "Read(//**/.local-db/**)",
      "Edit(//**/.local-db/**)",
      "Read(//**/.ssh/**)",
      "Edit(//**/.ssh/**)",
      "Read(//**/.aws/**)",
      "Edit(//**/.aws/**)",
      "Read(//**/.kube/**)",
      "Edit(//**/.kube/**)",
      "Read(//**/.gnupg/**)",
      "Edit(//**/.gnupg/**)",

      "Bash(env)",
      "Bash(env -*)",
      "Bash(set)",
      "Bash(printenv*)",
      "Bash(export -p*)",
      "Bash(declare -x*)",
      "Bash(docker inspect*)",
      "Bash(docker exec*)",
      "Bash(gh auth token*)",
      "Bash(npm token*)",
      "Bash(kubectl config view*)",
      "Bash(aws configure get*)",
      "Bash(base64 *)",
      "Bash(certutil *-encode*)",
      "Bash(*BEGIN*PRIVATE KEY*)",
      "PowerShell(Get-ChildItem Env:*)",
      "PowerShell(Get-Item Env:*)",
      "PowerShell(gci Env:*)",
      "PowerShell(ls Env:*)",
      "PowerShell(dir Env:*)",
      "PowerShell(Get-ChildItem -Path Env:*)",
      "PowerShell(*GetEnvironmentVariables*)",
      "PowerShell(docker inspect*)",
      "PowerShell(docker exec*)",
      "PowerShell(gh auth token*)",
      "PowerShell(npm token*)",
      "PowerShell(kubectl config view*)",
      "PowerShell(aws configure get*)",
      "PowerShell(certutil *-encode*)",
      "PowerShell(*BEGIN*PRIVATE KEY*)",

      "Bash(docker compose *)",
      "Bash(docker-compose *)",
      "PowerShell(docker compose *)",
      "PowerShell(docker-compose *)",

      "Bash(git reset *--hard*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * +*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(git commit *--no-verify*)",
      "Bash(gh pr ready*)",
      "Bash(gh pr merge*)",
      "PowerShell(git reset *--hard*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * +*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git commit * -n*)",
      "PowerShell(git commit *--no-verify*)",
      "PowerShell(gh pr ready*)",
      "PowerShell(gh pr merge*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch)",
      "Bash(git branch -v:*)",
      "Bash(git branch -vv:*)",
      "Bash(git branch -a:*)",
      "Bash(git branch -r:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git show:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec prettier --check:*)",
      "Bash(pnpm test:*)",
      "Bash(./scripts/gate/verify.sh:*)",
      "Bash(./scripts/gate/selfcheck.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/docs-standard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/warn-orphan-server.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
