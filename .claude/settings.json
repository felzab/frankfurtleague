{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Write(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Write(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(**/*.pem)",
      "Write(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/id_rsa*)",
      "Write(**/id_rsa*)",
      "Edit(**/id_rsa*)",
      "Read(**/credentials.json)",
      "Write(**/credentials.json)",
      "Edit(**/credentials.json)",
      "Read(./certs/**)",
      "Write(./certs/**)",
      "Edit(./certs/**)",
      "Read(**/kubeconfig)",
      "Write(**/kubeconfig)",
      "Edit(**/kubeconfig)",
      "Read(**/*-service-account*.json)",
      "Write(**/*-service-account*.json)",
      "Edit(**/*-service-account*.json)",
      "Read(**/*.key)",
      "Write(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.p12)",
      "Write(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(**/*.pfx)",
      "Write(**/*.pfx)",
      "Edit(**/*.pfx)",
      "Read(**/*.p8)",
      "Write(**/*.p8)",
      "Edit(**/*.p8)",
      "Read(**/id_ed25519*)",
      "Write(**/id_ed25519*)",
      "Edit(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Write(**/id_ecdsa*)",
      "Edit(**/id_ecdsa*)",
      "Read(**/.npmrc)",
      "Write(**/.npmrc)",
      "Edit(**/.npmrc)",
      "Read(./secrets/**)",
      "Write(./secrets/**)",
      "Edit(./secrets/**)",
      "Read(./.local-db/**)",
      "Write(./.local-db/**)",
      "Edit(./.local-db/**)",
      "Read(**/*.crt)",
      "Write(**/*.crt)",
      "Edit(**/*.crt)",
      "Read(**/*.cer)",
      "Write(**/*.cer)",
      "Edit(**/*.cer)",
      "Read(**/*.pk8)",
      "Write(**/*.pk8)",
      "Edit(**/*.pk8)",
      "Read(**/*.asc)",
      "Write(**/*.asc)",
      "Edit(**/*.asc)",
      "Read(**/*.gpg)",
      "Write(**/*.gpg)",
      "Edit(**/*.gpg)",
      "Read(**/*.ovpn)",
      "Write(**/*.ovpn)",
      "Edit(**/*.ovpn)",
      "Read(**/*.jks)",
      "Write(**/*.jks)",
      "Edit(**/*.jks)",
      "Read(**/*.keystore)",
      "Write(**/*.keystore)",
      "Edit(**/*.keystore)",
      "Read(**/*.ppk)",
      "Write(**/*.ppk)",
      "Edit(**/*.ppk)",
      "Read(**/*.kdbx)",
      "Write(**/*.kdbx)",
      "Edit(**/*.kdbx)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch)",
      "Bash(git branch -v:*)",
      "Bash(git branch -vv:*)",
      "Bash(git branch -a:*)",
      "Bash(git branch -r:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git show:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec prettier --check:*)",
      "Bash(pnpm test:*)",
      "Bash(./scripts/gate/verify.sh:*)",
      "Bash(./scripts/gate/selfcheck.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-branch.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-standard-edit.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-credential-shell.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-branch-bash.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-standard-bash.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-local-compose.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-branch-powershell.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-stale-type-class.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/docs-standard.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/warn-orphan-server.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
