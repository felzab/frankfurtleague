{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Read(//**/.env*)",
      "Edit(//**/.env*)",
      "Read(//**/certs/**)",
      "Edit(//**/certs/**)",
      "Read(//**/secrets/**)",
      "Edit(//**/secrets/**)",
      "Read(//**/.local-db/**)",
      "Edit(//**/.local-db/**)",

      "Bash(docker inspect*)",
      "Bash(docker exec*)",
      "PowerShell(docker inspect*)",
      "PowerShell(docker exec*)",

      "Bash(docker compose *)",
      "Bash(docker-compose *)",
      "PowerShell(docker compose *)",
      "PowerShell(docker-compose *)",

      "Bash(git reset *--hard*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * +*)",
      "Bash(gh pr ready*)",
      "Bash(gh pr merge*)",
      "PowerShell(git reset *--hard*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * +*)",
      "PowerShell(gh pr ready*)",
      "PowerShell(gh pr merge*)"
    ],
    "allow": [
      "Bash(pnpm run typecheck)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run knip)",
      "Bash(pnpm run knip:prod)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch)",
      "Bash(git branch -v:*)",
      "Bash(git branch -vv:*)",
      "Bash(git branch -a:*)",
      "Bash(git branch -r:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git show:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec prettier --check:*)",
      "Bash(pnpm test:*)",
      "Bash(./scripts/gate/verify.sh:*)",
      "Bash(./scripts/gate/selfcheck.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(mcp__.*|Skill)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/writer-tools.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/format-written.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/orchestration-messages.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "implementer|driving-reauditor|researcher|cold-auditor|reader",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/agent-definition.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/orchestration-compact.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
