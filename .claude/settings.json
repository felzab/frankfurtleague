{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "extraKnownMarketplaces": {
    "orchestra": {
      "source": {
        "source": "github",
        "repo": "felzab/orchestra"
      }
    }
  },
  "enabledPlugins": {
    "orchestra@orchestra": true
  },
  "permissions": {
    "deny": [
      "Read(//**/.env*)",
      "Edit(//**/.env*)",
      "Read(//**/certs/**)",
      "Edit(//**/certs/**)",
      "Read(//**/secrets/**)",
      "Edit(//**/secrets/**)",
      "Read(//**/.local-db/**)",
      "Edit(//**/.local-db/**)",

      "Bash(docker inspect*)",
      "Bash(docker exec*)",
      "PowerShell(docker inspect*)",
      "PowerShell(docker exec*)",

      "Bash(docker compose *)",
      "Bash(docker-compose *)",
      "PowerShell(docker compose *)",
      "PowerShell(docker-compose *)",

      "Bash(git reset *--hard*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * +*)",
      "Bash(gh pr ready*)",
      "Bash(gh pr merge*)",
      "PowerShell(git reset *--hard*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * +*)",
      "PowerShell(gh pr ready*)",
      "PowerShell(gh pr merge*)"
    ],
    "allow": [
      "Bash(pnpm run typecheck)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run knip)",
      "Bash(pnpm run knip:prod)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier --check *)",
      "Bash(./scripts/gate/verify.sh *)",
      "Bash(./scripts/gate/selfcheck.sh *)",
      "Bash(orchestra *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/format-written.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
