# Personal Claude Code settings for this repo. Shared settings belong in settings.json; this file is
# the per-developer override and must never be committed.
settings.local.json

# Claude Code puts each writing or planting agent's git worktree here, a whole second tree with its
# own node_modules and .venv. .git/info/exclude is machine-local, absent from a fresh clone, so
# without a tracked rule that tree reads as untracked.
worktrees/
