
# nginx mounts ./certs read-only on the server (docker-compose.yml); a development checkout has
# no such directory. The rule is here for whoever creates one locally -- a private key must never
# be committable from this repository.
certs/

# Mirrors the deny list in .claude/settings.json, because those tools are not the only route into
# a commit -- a shell command, an installer or an external editor is git's problem alone.
# Unanchored: a private key is one wherever it lands.
.env*
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.p8
*.pk8
id_rsa*
id_ed25519*
id_ecdsa*
credentials.json
*-service-account*.json
kubeconfig
secrets/

# Where the list stops, deliberately: private-key and keystore containers plus OpenSSH's default
# key names -- the shapes that leak by being committed. Not public material, not $HOME files, not
# names too generic to pattern. Widen it here.

# Not a key file but one that grows a key: a registry auth token lands here on `pnpm login`, in a
# file unremarkable enough to commit without a second look. No .npmrc is tracked, so this hides
# nothing -- a deliberate one needs `git add -f`.
.npmrc

# Fixture directories scripts/gate/verify.sh and scripts/gate/selfcheck.sh build; their EXIT trap misses
# Ctrl-C and SIGKILL. Unignored, a leftover is an untracked change the next scoped run refuses
# over, and one guard-branch-bash.sh denies on main.
.tmp-*/

# Docker Desktop on Windows creates these when Git Bash MSYS conversion mangles a bind-mount path
# (":" separators become ";C:\..."). Empty and useless. Prevent one by prefixing a hand-typed
# bind mount with MSYS_NO_PATHCONV=1, per CLAUDE.md §5.
*;C
*;C/

# Personal Claude Code settings for this repo. Shared settings belong in .claude/settings.json;
# this file is the per-developer override and must never be committed.
.claude/settings.local.json

# A parallel session may put its git worktree inside this repository -- a whole second tree, with
# its own node_modules and .venv. .git/info/exclude is machine-local, absent from a fresh clone,
# so without a tracked rule that tree reads as untracked.
.claude/worktrees/

# Python bytecode. scripts/ holds scripts that are run rather than imported, so this fills only
# when something imports one -- a test harness, or a REPL. A build artifact either way.
__pycache__/
*.pyc

# The gate runs ruff and pytest from the root, from scripts/ and from fl_backend/, and each
# working directory grows its own cache. Both tools write a .gitignore inside one; coverage here
# does not rest on their continuing to.
.pytest_cache/
.ruff_cache/

# Audit working documents, local-only by design: the repo is public and these carry findings not
# yet fixed. A finished programme's account is written here beside its working files. Ignored but not
# secret -- CLAUDE.md §1 carves this path out.
docs/audit/

# Editor settings. The two workspace files are tracked, because they point the editor at the same
# prettier, configuration and ignore file the gate runs -- a save then produces what CI checks.
# Everything else here is one developer's: a launch profile, a window layout, a local override.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# The copy of the production database `./scripts/ops/local.sh --seed` restores the local stack from.
# Real data, and this repository is public.
.local-db/
