# Prettier runs over the whole repository from fl_frontend, and --ignore-path replaces its default
# lookup of ./.gitignore and ./.prettierignore, so every tree it must not check is named here.
# Patterns resolve relative to this file. A line spares the reads and never the walk: prettier lists
# every entry under `..` before it asks this file. A file of a kind no parser takes, a log, a key or a
# dotenv file, is never read, so no line names one.

# Prettier's own .git exclusion does not match under the `..` root it runs from.
.git

fl_backend/.venv
.pytest_cache

# Installed and built trees, nothing under which is written by hand.
fl_frontend/.next/
fl_frontend/out/
next-env.d.ts

# Generated, and never formatted by hand: a hand reformat drifts again on the next regeneration and
# buries the change its diff carries. Orval formats its own output as it writes it
# (`fl_frontend/orval.config.ts`).
fl_backend/openapi.json
fl_frontend/src/core/generated/
pnpm-lock.yaml

# The fixtures a gate run leaves when Ctrl-C skips its EXIT trap.
.tmp-*/

# Machine-local files. The two tracked workspace files are the exception -- a tracked file the format
# gate skips is one nothing holds to the repository's own style.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
# A leftover copy of production's database, which this public repository must never take. Named here
# as well as in .gitignore because `--ignore-path` replaces prettier's own .gitignore lookup, so
# without this line the format scope fails on a dump's metadata and its remedy rewrites that dump.
.local-db/
