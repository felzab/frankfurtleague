# Prettier runs over the whole repository from fl_frontend, and --ignore-path replaces its default
# lookup of ./.gitignore and ./.prettierignore, so every tree it must not enter is named here.
# Patterns resolve relative to this file.

.git
docs/audit
certs
fl_backend/.venv
__pycache__
.pytest_cache
.ruff_cache

# Installed and built trees: walking node_modules alone is the difference between seconds and
# minutes, and nothing under any of these is written by hand.
node_modules
fl_frontend/.next/
fl_frontend/out/
fl_frontend/coverage
*.tsbuildinfo
next-env.d.ts

# Generated: formatting one only guarantees it drifts again on the next regeneration, and the
# reformat would bury the change its diff carries.
fl_backend/openapi.json
pnpm-lock.yaml

# Nested worktrees and the gate's throwaway fixtures are held outside git by mechanisms
# --ignore-path cannot read -- .git/info/exclude, and an EXIT trap that Ctrl-C skips.
.claude/worktrees/
.tmp-*/

# Machine-local files, and credential shapes a formatter has no business opening at all. The two
# tracked workspace files are the exception -- a tracked file the format gate skips is one nothing
# holds to the repository's own style.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.claude/settings.local.json
.env*
*.pem
# The copy of the production database `./scripts/local.sh --seed` leaves behind. Named here as well
# as in .gitignore because `--ignore-path` replaces prettier's own .gitignore lookup, so without
# this line the format scope fails on a dump's metadata and its remedy rewrites that dump.
.local-db/
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
