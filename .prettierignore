# Repo-root ignore list. Prettier runs from fl_frontend against `..`, so every path
# here is relative to the repo root. fl_frontend/.prettierignore still applies to
# fl_frontend's own tree; this file only adds what lives above it.

# The backend is ruff's, not prettier's — and .venv holds third-party sources.
fl_backend/

# Generated
fl_frontend/node_modules/
fl_frontend/.next/
fl_frontend/out/
pnpm-lock.yaml

# Not prettier-parseable; listed so the skip is intentional rather than incidental
nginx/
scripts/
