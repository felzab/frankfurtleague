{
  "name": "fl_frontend",
  "version": "0.1.0",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11.18.0"
  },
  "packageManager": "pnpm@11.28.3",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 ACTOR_SIGNING_KEY_FILE=../secrets/fl_actor_signing_key SECRETS_DIR=../secrets next dev --turbo",
    "build": "next build",
    "environment-names": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/tsconfig-alias-hook.mjs scripts/emit-environment-names.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "knip": "knip --no-progress --treat-config-hints-as-errors",
    "format": "prettier --write .. --ignore-path ../.prettierignore",
    "format:check": "prettier --check .. --ignore-path ../.prettierignore --cache --cache-strategy content",
    "typegen": "next typegen",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "typecheck:only": "tsc --noEmit",
    "test": "pnpm run test:base \"**/!(*.db).test.{cjs,mjs,js,cts,mts,ts}\" \"**/*-test.{cjs,mjs,js,cts,mts,ts}\" \"**/*_test.{cjs,mjs,js,cts,mts,ts}\" \"**/test-*.{cjs,mjs,js,cts,mts,ts}\" \"**/test.{cjs,mjs,js,cts,mts,ts}\" \"**/test/**/*.{cjs,mjs,js,cts,mts,ts}\"",
    "test:base": "cross-env SKIP_ENV_VALIDATION=true node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/tsconfig-alias-hook.mjs --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/case-count-reporter.mjs --test-reporter-destination=stderr",
    "test:db": "pnpm run test:base \"**/*.db.test.{cjs,mjs,js,cts,mts,ts}\"",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.7",
    "@better-auth/passkey": "^1.7.7",
    "@gravity-ui/icons": "^2.22.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "^1.7.7",
    "client-only": "^0.0.1",
    "fuse.js": "^7.5.0",
    "jose": "^6.2.12",
    "mongodb": "^7.7.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-aria": "^3.52.1",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "svix": "^2.6.1",
    "tailwind-variants": "^3.3.1",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/mongodb": "^12.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.1",
    "knip": "^6.39.0",
    "postcss": "^8.5.26",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "not dead"
  ]
}
