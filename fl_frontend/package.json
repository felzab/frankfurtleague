{
  "name": "fl_frontend",
  "version": "0.1.0",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11.18.0"
  },
  "packageManager": "pnpm@11.28.9",
  "scripts": {
    "build": "next build",
    "lint": "pnpm typegen && pnpm lint:only",
    "lint:only": "eslint . --max-warnings 0 --concurrency auto",
    "knip": "knip --no-progress --treat-config-hints-as-errors",
    "knip:prod": "knip --production --no-progress --treat-config-hints-as-errors --config knip.production.json",
    "format": "prettier --write .. \"!../.claude/worktrees/**\" --ignore-path ../.prettierignore --cache --cache-strategy content",
    "format:check": "prettier --check .. \"!../.claude/worktrees/**\" --ignore-path ../.prettierignore --cache --cache-strategy content",
    "lint:md": "cd .. && markdownlint-cli2",
    "typegen": "next typegen",
    "typecheck": "pnpm typegen && pnpm typecheck:only",
    "typecheck:only": "tsc --noEmit",
    "contract": "uv run --directory ../fl_backend --frozen python -m app.openapi_document && orval --fail-on-warnings",
    "test": "vitest run --project='!db*'",
    "test:base": "vitest run",
    "test:db": "vitest run --project='db*'",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.26",
    "@better-auth/passkey": "^1.7.26",
    "@internationalized/date": "^3.12.4",
    "better-auth": "^1.7.26",
    "client-only": "^0.0.1",
    "lucide-react": "^1.73.0",
    "mongodb": "^7.9.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "standardwebhooks": "^1.1.1",
    "tailwind-variants": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.65.1",
    "@react-aria/optimize-locales-plugin": "^2.1.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testcontainers/mongodb": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "markdownlint-cli2": "^0.24.1",
    "orval": "8.48.0",
    "postcss": "^8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "not dead"
  ]
}
