{
  "name": "fl_frontend",
  "version": "0.1.0",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11.18.0"
  },
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 SECRETS_DIR=../secrets next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "knip": "knip --no-progress --treat-config-hints-as-errors",
    "knip:prod": "knip --production --no-progress --treat-config-hints-as-errors --config knip.production.json",
    "format": "prettier --write .. \"!../.claude/worktrees/**\" --ignore-path ../.prettierignore",
    "format:check": "prettier --check .. \"!../.claude/worktrees/**\" --ignore-path ../.prettierignore --cache --cache-strategy content",
    "lint:md": "cd .. && markdownlint-cli2",
    "typegen": "next typegen",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "typecheck:only": "tsc --noEmit",
    "contract": "uv run --directory ../fl_backend --frozen python -m app.openapi_document && orval",
    "test": "vitest run --project unit",
    "test:base": "vitest run",
    "test:db": "vitest run --project db",
    "e2e": "playwright test",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.10",
    "@better-auth/passkey": "^1.7.10",
    "@gravity-ui/icons": "^2.23.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@internationalized/date": "^3.12.4",
    "better-auth": "^1.7.10",
    "client-only": "^0.0.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.62.0",
    "mongodb": "^7.7.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "svix": "^2.8.0",
    "tailwind-variants": "^3.3.1",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.64.1",
    "@react-aria/optimize-locales-plugin": "^2.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/mongodb": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.1.3",
    "knip": "^6.42.0",
    "markdownlint-cli2": "^0.24.0",
    "orval": "8.45.0",
    "postcss": "^8.5.30",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "not dead"
  ]
}
