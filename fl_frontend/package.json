{
  "name": "fl_frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26",
    "pnpm": ">=11.18.0"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write . ../docs ../scripts ../.claude ../CLAUDE.md ../docker-compose.yml ../docker-compose.local.yml",
    "format:check": "prettier --check . ../docs ../scripts ../.claude ../CLAUDE.md ../docker-compose.yml ../docker-compose.local.yml",
    "verify": "pnpm format && pnpm exec tsc --noEmit && pnpm exec eslint . && pnpm format:check && pnpm build && pnpm test && pnpm audit:prod",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tsconfig-alias-hook.mjs --test",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.3",
    "@gravity-ui/icons": "^2.21.0",
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@internationalized/date": "^3.12.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "fuse.js": "^7.5.0",
    "mongodb": "^6.21.0",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tailwind-variants": "^3.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not dead",
    "supports es6-module",
    "fully supports es6-module"
  ]
}
