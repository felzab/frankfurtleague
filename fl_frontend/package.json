{
  "name": "fl_frontend",
  "version": "0.1.0",
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.x",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=11.18.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next dev --turbo",
    "build": "next build",
    "environment-names": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tsconfig-alias-hook.mjs emit-environment-names.mjs",
    "start": "next start",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .. --ignore-path ../.prettierignore",
    "format:check": "prettier --check .. --ignore-path ../.prettierignore --cache --cache-strategy content",
    "typegen": "cross-env SKIP_ENV_VALIDATION=true MONGODB_URI=mongodb://localhost:27017/placeholder next typegen",
    "typecheck": "pnpm typegen && tsc --noEmit",
    "typecheck:only": "tsc --noEmit",
    "test": "cross-env SKIP_ENV_VALIDATION=true MONGODB_URI=mongodb://localhost:27017/placeholder node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./app-source-maps.mjs --import ./tsconfig-alias-hook.mjs --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./worker-exit-reporter.mjs --test-reporter-destination=stderr \"**/!(*.db).test.{cjs,mjs,js,cts,mts,ts}\" \"**/*-test.{cjs,mjs,js,cts,mts,ts}\" \"**/*_test.{cjs,mjs,js,cts,mts,ts}\" \"**/test-*.{cjs,mjs,js,cts,mts,ts}\" \"**/test.{cjs,mjs,js,cts,mts,ts}\" \"**/test/**/*.{cjs,mjs,js,cts,mts,ts}\"",
    "test:db": "cross-env SKIP_ENV_VALIDATION=true MONGODB_URI=mongodb://localhost:27017/placeholder node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./app-source-maps.mjs --import ./tsconfig-alias-hook.mjs --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./worker-exit-reporter.mjs --test-reporter-destination=stderr \"**/*.db.test.{cjs,mjs,js,cts,mts,ts}\"",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.5",
    "@better-auth/passkey": "^1.7.5",
    "@gravity-ui/icons": "^2.22.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@internationalized/date": "^3.12.4",
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "^1.7.5",
    "fuse.js": "^7.5.0",
    "mongodb": "^6.21.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "svix": "^2.3.0",
    "tailwind-variants": "^3.3.1",
    "zod": "~4.4.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/mongodb": "^12.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "not dead"
  ]
}
