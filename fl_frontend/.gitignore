# Anchored to this directory: a `node_modules` or `.next` deeper in the tree would be someone's
# source, not an artifact. The standalone output next.config.ts asks for is written inside .next/,
# so it needs no rule of its own.
/node_modules
/.next/

# Generated beside the source and derived from tracked files: tsc writes its incremental cache even
# under --noEmit, and next rewrites next-env.d.ts on every build.
*.tsbuildinfo
next-env.d.ts

# eslint's lint-result cache. Untracked by design: the gate reads and writes it on every
# --frontend run, and its key is `eslint.config.mjs :: crossFileDigest` plus eslint's own.
/.eslintcache
