{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["node"],
    // Explicitly false, not omitted: `next build` writes its suggested defaults for any key that is
    // absent from compilerOptions (a presence check, not a value check), so deleting this line makes
    // every build re-add `"allowJs": true` and reformat the whole file. Declared false, it is left
    // alone -- and a stray .js import is a compile error rather than unchecked code, since checkJs is off.
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // Test files import with an explicit .ts extension because Node's ESM resolver requires
    // one; safe under noEmit, and nothing is emitted for tsc to rewrite.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
