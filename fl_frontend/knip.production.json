{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The production run (https://knip.dev/features/production-mode), kept out of `knip.json`: knip
  // reads one file in either mode, and `ignoreExportsUsedInFile` there would loosen the default run
  // as `knip.json`'s schema ignore would loosen this one.

  // Production code no `start` script reaches: the image build runs the first under the third, and
  // the deploy's preflight runs the second.
  "entry": ["scripts/emit-environment-names.mjs!", "scripts/check-environment-names.mjs!", "scripts/tsconfig-alias-hook.mjs!"],
  // Every file but the tests' own support modules, one folder no production module imports
  // (`fl_frontend/eslint.config.mjs :: kindOf`), the end-to-end journeys' support, and the lint's
  // own rules, which only `eslint.config.mjs` imports.
  "project": ["**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}!", "!src/test-support/**!", "!e2e/**!", "!eslint-rules/**!"],
  // Built ahead of their first page, each named with the session that first uses it, which deletes
  // its line here and in `knip.json`.
  "ignoreFiles": [
    // Session 1, the spike's pages.
    "src/core/clock.ts",
    "src/core/routes.ts",
    "src/kit/Button.tsx",
    "src/kit/Link.tsx",
    "src/kit/Stack.tsx",
    "src/kit/Inline.tsx",
    "src/kit/Icon.tsx",
    "src/kit/Tooltip.tsx",
    "src/kit/TextField.tsx",
    "src/kit/Select.tsx",
    "src/kit/ComboBox.tsx",
    "src/kit/DateField.tsx",
    "src/kit/TimeField.tsx",
    "src/kit/CodeField.tsx",
    "src/kit/Chip.tsx",
    "src/kit/TeamPlaque.tsx",
    "src/kit/FieldParts.tsx",
    "src/kit/fieldStyles.ts",
    "src/kit/OptionList.tsx",
    "src/kit/dateParts.tsx",
    "src/kit/Tabs.tsx",
    "src/kit/MatchRow.tsx",
    "src/kit/Table.tsx",
    "src/kit/EmptyState.tsx",
    "src/kit/Section.tsx",
    "src/kit/HelpPopover.tsx",
    "src/kit/ConfirmDialog.tsx",
    "src/kit/Dialog.tsx",
    "src/kit/Sheet.tsx",
    "src/kit/Menu.tsx",
    "src/kit/SeasonButton.tsx",
    "src/kit/Toast.tsx",
    "src/kit/buttonStyles.ts",
    "src/kit/Brand.tsx",
    "src/kit/FrameNav.tsx",
    "src/kit/LeaveGuard.tsx",
    "src/kit/RailFrame.tsx",
    "src/kit/ClassicFrame.tsx",
    "src/kit/ClassicPage.tsx",
    "src/kit/ListPage.tsx",
    "src/kit/ListTable.tsx",
    "src/kit/EditorPage.tsx",
    "src/kit/EditorBar.tsx",
    "src/kit/useEditor.ts",
    "src/kit/useFormAction.ts",
    // Session 3.
    "src/kit/BracketCard.tsx",
    "src/kit/Filters.tsx",
    "src/kit/Facts.tsx",
    "src/kit/Skeleton.tsx",
    "src/kit/StatusPage.tsx",
    "src/kit/ReadPage.tsx",
    // Session 4.
    "src/kit/Checkbox.tsx",
    "src/kit/RadioGroup.tsx",
    "src/kit/Prose.tsx",
    "src/kit/Callout.tsx",
    "src/kit/KontoBox.tsx",
    "src/kit/MailedPage.tsx",
    "src/kit/OneShot.tsx",
    // Session 5.
    "src/kit/Switch.tsx",
    "src/kit/SearchField.tsx"
  ],
  // Session 1, the kit's icon set, first imported by the spike's pages.
  "ignoreDependencies": ["lucide-react"],
  "ignoreIssues": {
    // An inferred type stays beside its schema, and an alias is a component of its own. The type's
    // `typeof` counts as its schema's use under the setting at the foot, so no unread schema that has
    // one is named here.
    "src/**/schemas.ts": ["types", "duplicates"],
    // `.claude/rules/cross-surface.md`'s **system** clause keeps `checkIsReady` and `getSystemInfo`.
    "src/features/system/queries.ts": ["exports"],
    // Session 1, the spike's pages: the formatters wait for their first page.
    "src/core/format.ts": ["exports"]
  },
  // An export its tests import passes while its own module uses it, and fails once nothing in
  // production does. `@internal` would exempt it for good, after its module stops using it too.
  "ignoreExportsUsedInFile": true
}
